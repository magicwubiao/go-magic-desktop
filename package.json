{
  "name": "go-magic-desktop",
  "version": "0.0.0",
  "description": "Go Magic Desktop App - Powered by Tauri",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:macos": "tauri build --target x86_64-apple-darwin",
    "build:macos-arm": "tauri build --target aarch64-apple-darwin",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "version:sync": "node scripts/sync-version.mjs",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.1.0",
    "@tauri-apps/plugin-log": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "tauri",
    "go-magic",
    "desktop",
    "ai",
    "development-tools"
  ],
  "author": "Go Magic Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magicwubiao/go-magic-desktop"
  },
  "bugs": {
    "url": "https://github.com/magicwubiao/go-magic-desktop/issues"
  }
}
