{
  "name": "go-magic-desktop",
  "version": "0.4.12",
  "description": "Go Magic Desktop App - Powered by Tauri",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "node sync-version.mjs && tauri build",
    "build:windows": "node sync-version.mjs && tauri build --target x86_64-pc-windows-msvc",
    "build:macos": "node sync-version.mjs && tauri build --target x86_64-apple-darwin",
    "build:linux": "node sync-version.mjs && tauri build --target x86_64-unknown-linux-gnu",
    "version": "node sync-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-shell": "^2.1.0",
    "@tauri-apps/plugin-fs": "^2.1.0",
    "@tauri-apps/plugin-os": "^2.1.0",
    "@tauri-apps/plugin-process": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.1.0",
    "@tauri-apps/plugin-http": "^2.1.0",
    "@tauri-apps/plugin-log": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "tauri",
    "go-magic",
    "desktop",
    "ai",
    "development-tools"
  ],
  "author": "Go Magic Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/magicwubiao/go-magic-desktop"
  },
  "bugs": {
    "url": "https://github.com/magicwubiao/go-magic-desktop/issues"
  }
}