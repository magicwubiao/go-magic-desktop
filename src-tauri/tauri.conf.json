{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Go Magic",
  "version": "1.0.0",
  "identifier": "com.gomagic.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5000",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Go Magic",
        "fullscreen": false,
        "resizable": true,
        "height": 900,
        "width": 1400,
        "minHeight": 700,
        "minWidth": 1000,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: blob: asset: https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright 2024 Go Magic Team",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Go Magic - AI-powered development assistant",
    "shortDescription": "AI-powered Development Assistant",
    "targets": "all",
    "resources": ["resources"],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}